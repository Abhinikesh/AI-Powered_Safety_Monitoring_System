# ──────────────────────────────────────────────────────────────────────────────
# SafeGuard AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the actual .env file — it's in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# MongoDB connection URI
# Local:   mongodb://localhost:27017/safety_monitoring
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/safety_monitoring
MONGO_URI=mongodb://localhost:27017/safety_monitoring

# Roboflow API Key — only needed to download the training dataset
# Get a free key at: https://app.roboflow.com → Account Settings → API Key
ROBOFLOW_API_KEY=your_roboflow_api_key_here
